# Root env example for docker-compose and shared settings

# MariaDB (Docker Compose scenario)
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=caravanshare
MARIADB_USER=caravan
MARIADB_PASSWORD=change-me-db-password

# API (Express + Prisma)
NODE_ENV=development
DATABASE_URL=mysql://caravan:change-me-db-password@db:3306/caravanshare
SESSION_SECRET=change-me-session-secret
SESSION_STORE=mysql

# Local dev frontend (Vite)
FRONTEND_BASE_URL=http://localhost:5173

# Example: production with domain (set only on server)
# FRONTEND_BASE_URL=https://caravanshare.xyz

# OAuth (examples only – use real values in local .env)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_CALLBACK_URL=http://localhost:3000/auth/naver/callback

KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_CALLBACK_URL=http://localhost:3000/auth/kakao/callback

# Production behind Nginx at https://caravanshare.xyz:
# GOOGLE_CALLBACK_URL=https://caravanshare.xyz/api/auth/google/callback
# NAVER_CALLBACK_URL=https://caravanshare.xyz/api/auth/naver/callback
# KAKAO_CALLBACK_URL=https://caravanshare.xyz/api/auth/kakao/callback

