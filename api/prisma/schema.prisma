generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  host
  admin
}

enum CaravanStatus {
  available
  reserved
  maintenance
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

enum SocialProvider {
  GOOGLE
  NAVER
  KAKAO
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  hashedPassword String?
  fullName       String?
  role           UserRole         @default(guest)
  balance        Float            @default(0)

  caravans       Caravan[]
  reservations   Reservation[]
  socialAccounts SocialAccount[]
  reviews        Review[]
  sentMessages   Message[]        @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  preReservationSentMessages     PreReservationMessage[] @relation("PreReservationSentMessages")
  preReservationReceivedMessages PreReservationMessage[] @relation("PreReservationReceivedMessages")

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SocialAccount {
  id             Int            @id @default(autoincrement())
  provider       SocialProvider
  providerUserId String

  userId         Int
  user           User           @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
}

model Caravan {
  id           Int             @id @default(autoincrement())
  name         String
  description  String
  capacity     Int
  amenities    String
  location     String
  imageUrl     String?
  price_per_day Float
  status       CaravanStatus   @default(available)

  host_id      Int?
  host         User?           @relation(fields: [host_id], references: [id])

  reservations Reservation[]
  reviews      Review[]
  preReservationMessages PreReservationMessage[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Reservation {
  id         Int               @id @default(autoincrement())
  user_id    Int
  caravan_id Int
  start_date DateTime
  end_date   DateTime
  price      Float
  status     ReservationStatus @default(pending)

  user       User              @relation(fields: [user_id], references: [id])
  caravan    Caravan           @relation(fields: [caravan_id], references: [id])
  messages   Message[]         @relation("ReservationMessages")

  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([caravan_id, start_date, end_date])
}

model Review {
  id         Int      @id @default(autoincrement())
  caravan_id Int
  user_id    Int
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  caravan    Caravan  @relation(fields: [caravan_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])

  @@index([caravan_id])
  @@index([user_id])
}

model Message {
  id             Int        @id @default(autoincrement())
  reservation_id Int
  sender_id      Int
  receiver_id    Int
  content        String
  createdAt      DateTime   @default(now())

  reservation    Reservation @relation("ReservationMessages", fields: [reservation_id], references: [id])
  sender         User        @relation("SentMessages", fields: [sender_id], references: [id])
  receiver       User        @relation("ReceivedMessages", fields: [receiver_id], references: [id])

  @@index([reservation_id])
  @@index([sender_id])
  @@index([receiver_id])
}

model PreReservationMessage {
  id          Int      @id @default(autoincrement())
  caravan_id  Int
  sender_id   Int
  receiver_id Int
  content     String
  createdAt   DateTime @default(now())

  caravan     Caravan  @relation(fields: [caravan_id], references: [id])
  sender      User     @relation("PreReservationSentMessages", fields: [sender_id], references: [id])
  receiver    User     @relation("PreReservationReceivedMessages", fields: [receiver_id], references: [id])

  @@index([caravan_id])
  @@index([sender_id])
  @@index([receiver_id])
}
