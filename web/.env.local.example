VITE_API_BASE_URL=http://localhost:3000

# Production build example (Azure VM + caravanshare.xyz)
# Put this into web/.env.production on the VM before building:
# VITE_API_BASE_URL=https://caravanshare.xyz/api

# Optional: Firebase Web SDK (not required for Passport-based OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
